# Quando a porta 80 já estiver em uso por outro serviço no VPS, o Caddy atende apenas a 443 e
# obtém o certificado pelo desafio TLS-ALPN-01, sem redirecionamentos nem desafio HTTP.
{
	auto_https disable_redirects
}

chatbot.example.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy 127.0.0.1:8000
}
